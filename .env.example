# Tautulli Exporter Configuration
# Copy this file to .env and update with your settings

# Required: Tautulli connection settings
TAUTULLI_URL=http://localhost:8181
TAUTULLI_API_KEY=your-api-key-here

# Optional: Exporter settings
EXPORTER_PORT=9487
EXPORTER_HOST=0.0.0.0

# Optional: Logging
LOG_LEVEL=INFO

# Optional: Feature flags
COLLECT_USER_STATS=true
COLLECT_LIBRARY_STATS=true
